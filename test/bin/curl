#!/bin/sh
# Mock curl: serves files from $MOCK_REGISTRY_DIR keyed by URL path ('/' -> '__').
# Honors -o FILE and -D FILE; logs every URL to $MOCK_CURL_LOG.
out=""; hdr=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -D) hdr="$2"; shift 2 ;;
    -u|-H) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
[ -n "$MOCK_CURL_LOG" ] && echo "$url" >> "$MOCK_CURL_LOG"
path="${url#https://*/}"
key=$(printf '%s' "$path" | sed 's|/|__|g')
src="${MOCK_REGISTRY_DIR}/${key}"
[ -n "$hdr" ] && : > "$hdr"
if [ -f "$src" ]; then
  if [ -n "$out" ]; then cp "$src" "$out"; else cat "$src"; fi
elif [ -n "$out" ]; then
  echo '{"errors":[{"code":"NAME_UNKNOWN","message":"not found"}]}' > "$out"
fi
exit 0
